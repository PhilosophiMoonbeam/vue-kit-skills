{
  "name": "vue-kit-tooling",
  "private": true,
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "1.4.5"
  },
  "scripts": {
    "lint": "bun --bun biome lint --error-on-warnings .",
    "lint:fix": "bun --bun biome lint --write --error-on-warnings .",
    "format": "bun --bun biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
