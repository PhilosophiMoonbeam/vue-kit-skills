{
  "name": "vue-kit-webgpu-verification",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "1.4.5"
  },
  "scripts": {
    "extract": "bun scripts/extract-source.mjs",
    "typecheck": "bun --bun vue-tsc --noEmit",
    "build": "bun run extract && bun run typecheck && bun --bun vite build && bun scripts/stage-source.mjs",
    "start": "bun server.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@tresjs/core": "5.12.0",
    "three": "0.187.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
